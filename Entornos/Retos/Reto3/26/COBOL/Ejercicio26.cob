IDENTIFICATION DIVISION.
PROGRAM-ID. EJERCICIO26.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 HORAS-LENGUAJES       PIC 9(3) VALUE 128.
01 HORAS-REDES           PIC 9(3) VALUE 192.
01 HORAS-HARDWARE        PIC 9(3) VALUE 96.
01 MAX-FALTAS-LENGUAJES  PIC 9(3)V99.
01 MAX-FALTAS-REDES      PIC 9(3)V99.
01 MAX-FALTAS-HARDWARE   PIC 9(3)V99.
01 FALTAS-REDES          PIC 9(3).
01 RESULTADO             PIC X(5).

PROCEDURE DIVISION.
    COMPUTE MAX-FALTAS-LENGUAJES =
        HORAS-LENGUAJES * 20 / 100
    COMPUTE MAX-FALTAS-REDES =
        HORAS-REDES * 20 / 100
    COMPUTE MAX-FALTAS-HARDWARE =
        HORAS-HARDWARE * 20 / 100

    DISPLAY "a) Faltas máximas permitidas:"
    DISPLAY "Lenguajes de marcas: " MAX-FALTAS-LENGUAJES
    DISPLAY "Redes: " MAX-FALTAS-REDES
    DISPLAY "Hardware: " MAX-FALTAS-HARDWARE

    DISPLAY "b) Introduzca el número de faltas del alumno en Redes"
    ACCEPT FALTAS-REDES

    IF FALTAS-REDES > MAX-FALTAS-REDES
        MOVE "true" TO RESULTADO
    ELSE
        MOVE "false" TO RESULTADO
    END-IF

    DISPLAY "¿Ha superado las faltas permitidas en Redes?: "
        RESULTADO

    STOP RUN.
